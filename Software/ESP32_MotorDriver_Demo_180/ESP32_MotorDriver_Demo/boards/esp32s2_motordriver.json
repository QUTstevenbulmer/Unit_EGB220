{
  "build": {
    "arduino": {
      "ldscript": "esp32s2_out.ld"
    },
    "core": "esp32",
    "extra_flags": "-DARDUINO_ESP32S2_DEV -DARDUINO_ESP32S2_MOTORDRIVER",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "hwids": [
      ["0x303A", "0x0002"]
    ],
    "mcu": "esp32s2",
    "variant": "esp32s2"
  },
  "connectivity": ["wifi"],
  "debug": {
    "openocd_target": "esp32s2.cfg"
  },
  "frameworks": ["arduino", "espidf"],
  "name": "ESP32-S2-SOLO-N4 Motor Driver (4MB flash, no PSRAM)",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 921600,
    "use_1200bps_touch": true,
    "wait_for_upload_port": true
  },
  "url": "https://www.espressif.com/en/products/modules",
  "vendor": "Custom"
}
